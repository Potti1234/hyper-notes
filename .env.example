# Copy to .env (or run `npm run setup`, which fills in random secrets).
# The app does not start in production without the two secrets.
APP_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
HYPER_SNAPSHOT_SECRET=change-me-to-another-long-random-string-of-32-or-more
# Postgres takes its password only when it first creates its volume; set it
# before the first `docker compose up` on a server (npm start then needs
# DATABASE_URL to match). Its port is bound to localhost.
# POSTGRES_PASSWORD=change-me
# Host ports
APP_PORT=4300
DB_PORT=5436
